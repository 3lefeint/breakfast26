{
  "name": "breakfast-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "MatchRoom" },
      { "name": "LIMITER", "class_name": "RateLimiter" },
      { "name": "VOICE", "class_name": "VoiceRoom" }
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "breakfast-telemetry", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom", "RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["VoiceRoom"] }
  ]
}
