# Breakfast configuration
# Copy this file to config.toml and fill in your values.
# Run with: python main.py            (mode taken from this file)
#       or: python main.py direct     (mode forced via CLI)
# CLI arguments always override values in this file.

# Active mode: "direct" (email/password + cloud WebSocket)
mode = "direct"

# ── Direct mode ───────────────────────────────────────────────────────────────
[direct]
email     = "user@example.com"
password  = "your-password"
board_id  = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Local Autodarts board WebSocket (used by elimination mode / freeplay only).
# Default assumes Autodarts runs on the same host as Breakfast.
# Override when running Breakfast in a container:
#   - Autodarts as a sibling container in the same docker-compose.yml:
#       board_ws_url = "ws://autodarts:3180/api/events"
#   - Autodarts native on the host, Breakfast containerized (e.g. Windows):
#       board_ws_url = "ws://host.docker.internal:3180/api/events"
# board_ws_url = "ws://localhost:3180/api/events"

# Board manager link shown in the Web UI header. Default: auto-resolved
# from the Autodarts cloud API (plain http://<board-ip>:3180, works with
# no DNS/certificate — e.g. at a clubhouse). Override for a nicer
# home-lab domain:
# board_manager_url = "https://dart-machine.example.com/"

# ── MQTT / Home Assistant / LED output ───────────────────────────────────────
# Fully optional — Elimination, the scoreboard, and the voice caller all work
# with no [mqtt] section at all. This only feeds Home Assistant sensors and
# ESPHome/LED displays over MQTT.
[mqtt]
enabled    = true   # explicit on/off switch, independent of leaving host blank
host       = "192.168.1.10"
port       = 1883
username   = "mqtt"
password   = "mqtt"
base_topic = "autodarts"

# ── Web UI ────────────────────────────────────────────────────────────────────
[web]
port = 8080
# theme = "default"         # "default", "ocean", "sunset", or "forest"
# accent_color = "#7c6aff"  # custom hex color, overrides the theme's accent
# aurora_animation = true  # false: the background of the interface stands still (saves power, less heat)
# aurora_palette = "northern"  # ready-made aurora colors: northern, ember, lavender, graphite, sakura (default: the theme's)
# aurora_streaks = true     # false: no tilted streaks, only the three color areas
# aurora_speed = 100        # % of the normal drift speed, 25..300
# aurora_intensity = 100    # % of the normal strength of the colors, 30..115
# aurora_blur = 100         # % of the normal softness, 30..200
# aurora_pause_idle = 0     # minutes without input until the aurora stops (it also stops while the page is hidden), 0 = never
# glass_strength = 100      # % of the normal milkiness of the glass panels, 50..200
# bar_opacity = 92          # % the top bar covers the page that scrolls under it, 50..100
# language = "en"          # language of the interface: "en" or "de"
# joke_of_the_day = true    # About page: joke from icanhazdadjoke.com; false = no outbound call

# ── Online Elimination ───────────────────────────────────────────────────────
# Play one Elimination match with Breakfast installations elsewhere, through a relay (see relay/README.md).
# [online]
# relay_url = "wss://breakfast-relay.example.workers.dev"
# site_name = "Home"        # how this installation shows up to the others

# ── Statistics (SQLite) ───────────────────────────────────────────────────────
# Per-turn data is stored here; lifetime and session stats are derived from it.
# Use "none" to disable stats collection entirely.
# [stats]
# db = "stats.db"
# timezone = "UTC"      # IANA name such as "Europe/Zurich"; turns stored UTC times into local days and hours

# ── Logging ───────────────────────────────────────────────────────────────────
[logging]
level = "INFO"    # DEBUG, INFO, WARNING, ERROR
events = false    # true: log each game event (dart-thrown etc.) at INFO level
# file = "/var/log/breakfast.log"   # optional, log to file in addition to stderr

# ── Optional features ─────────────────────────────────────────────────────────
# [audio]
# dir = "/home/user/autodarts-sounds"
# Optional voice-pack profile: sounds are looked up in <dir>/profiles/<profile>/
# first, your own files in <dir> cover any key the profile doesn't have.
# profile = "ryan"

# ── Voice caller (requires [audio] dir; playback via the /audio browser page) ─
# [caller]
# enabled = true            # false: no match calls (elimination audio unaffected)
# per_dart = true           # call every dart by field name (triple, double 16, ...)
# turn_total = true         # announce the turn total after the third dart
# checkout_limit = 1        # announce the same remaining score at most N times (0 = off)
# announce_change = true    # announce the incoming player on every change
# call_player = true        # player names at match/leg start and checkout calls
# ambient_volume = 0.6      # volume for ambient_* sounds (0 = ambient off)
# call_misses = true        # announce "outside" on a missed dart; false keeps
#                           # per-dart hit calls but silences just misses

# [record]
# file = "session.jsonl"

# ── Dev mode ──────────────────────────────────────────────────────────────────
# Exposes a Settings "Dev" tab to simulate a full X01 leg or Elimination match
# at runtime (no physical board needed) — see README "Dev mode". Off by
# default; not meant to be enabled on a shared/production instance.
# [dev]
# enabled = true

# [achievements.sounds]
# The sound an achievement plays when it is earned: one or more files of the achievements folder
# (<audio dir>/achievements/), one of them picked at random. Without an entry the file name
# convention applies (achievement_<id>.mp3, else achievement.mp3). Normally set on the page under
# Settings → Achievements, which shows with the Dev tab.
# ton_up = ["fanfare.mp3", "drumroll.mp3"]
