[Unit]
Description=Breakfast
Documentation=https://github.com/3lefeint/breakfast26
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

WorkingDirectory=/home/YOUR_USER/breakfast26
ExecStart=/home/YOUR_USER/breakfast26/.venv/bin/python main.py

# Restart automatically on crash, but not on clean exit (e.g. Ctrl-C)
Restart=on-failure
RestartSec=5

# Write logs to journald (view with: journalctl -u breakfast -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
